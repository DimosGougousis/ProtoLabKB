n prototyping and production for aerospace applications across all manufacturing processes.","keywords":["aerospace","aviation","aircraft","space","defense","prototyping","production","Inconel"]},{"id":"vertical-automotive-ev","name":"Automotive & EV Manufacturing Specialist","purpose":"Specialized agent for automotive, EV, and lightweight component manufacturing with expertise in weight reduction and electrification trends","keywords":["automotive","EV","electric vehicle","lightweighting","weight reduction","powertrain","battery enclosure","thermal management"]},{"id":"vertical-medical","name":"Medical Device Manufacturing Specialist","purpose":"Specialized agent for medical device manufacturing, biocompatible materials, and FDA-compliant prototyping guidance","keywords":["medical device","biocompatible","FDA","ISO 13485","sterilization","LSR","liquid silicone rubber","implantable"]}]}